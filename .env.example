# n8n Operator — example environment configuration.
#
# Copy to .env and fill in. Never commit .env.
#
# Credentials are owned by the server process: resolved here at startup, held in memory,
# and never written to the registry, the database, or logs (ADR-006). No MCP tool
# accepts or returns any value in this file.

# --- n8n instance (required) ------------------------------------------------
N8N_OPERATOR_N8N_BASE_URL=https://n8n.example.com
N8N_OPERATOR_N8N_API_KEY=

# --- Per-workflow webhook secrets -------------------------------------------
# Referenced indirectly from the registry as `secret_ref: env:NAME` (rule R6).
N8N_WEBHOOK_TOKEN_REPORTS=
N8N_WEBHOOK_TOKEN_CRM=
N8N_WEBHOOK_TOKEN_COMMS=

# --- Registry ---------------------------------------------------------------
N8N_OPERATOR_REGISTRY_PATH=./workflows.yaml

# --- Storage ----------------------------------------------------------------
# SQLite in v1; a PostgreSQL URL in v2 (ADR-004).
N8N_OPERATOR_DATABASE_URL=sqlite+pysqlite:///./n8n-operator.db

# --- Approval app (loopback only in v1) -------------------------------------
N8N_OPERATOR_APPROVAL_BIND=127.0.0.1:8765

# --- MCP Streamable HTTP transport ------------------------------------------
# Loopback by default. A non-loopback bind requires BOTH a bearer token and an
# Origin allowlist, or startup fails (boundary B9).
N8N_OPERATOR_HTTP_BIND=127.0.0.1:8000
# N8N_OPERATOR_HTTP_BEARER_TOKEN=
# N8N_OPERATOR_HTTP_ALLOWED_ORIGINS=https://client.example.com

# --- Behavior ---------------------------------------------------------------
N8N_OPERATOR_REQUEST_TIMEOUT_SECONDS=60
N8N_OPERATOR_LOG_LEVEL=INFO
