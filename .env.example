# ---------------------------------------------------------------------------
# n8n Operator — example configuration
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is not.
# PLACEHOLDERS ONLY — never put a real API key, token, password, or production
# URL in this file. Treat every commit as permanently public.
#
# All settings are read with the `N8N_OPERATOR_` prefix and validated at process
# start. See docs/ARCHITECTURE.md section 7 for defaults and notes.
#
# NOTE: the package that reads these variables is not implemented yet (Phase 0).
# ---------------------------------------------------------------------------

# --- n8n instance (required) -----------------------------------------------
# Base URL of the n8n instance Operator governs. Server-side only; never
# returned by any tool.
N8N_OPERATOR_N8N_BASE_URL=https://n8n.example.invalid

# n8n API key. Server-owned: never returned by a tool, never in the registry
# file, never sent to a client. Prefer a keyring reference over a literal.
N8N_OPERATOR_N8N_API_KEY=replace-me-with-your-n8n-api-key

# --- Registry ---------------------------------------------------------------
# Path to the approved-workflow registry. Load fails closed.
N8N_OPERATOR_REGISTRY_PATH=./workflows.yaml

# --- Storage ----------------------------------------------------------------
# SQLite in v1; a PostgreSQL URL in v2. Do not embed a password here — use a
# secret store or a peer/socket auth method.
N8N_OPERATOR_DATABASE_URL=sqlite+pysqlite:///./n8n-operator.db

# --- Approval app (loopback only in v1) -------------------------------------
N8N_OPERATOR_APPROVAL_BIND=127.0.0.1:8765

# --- MCP Streamable HTTP transport (optional) -------------------------------
# Loopback by default. A non-loopback bind requires BOTH a bearer token and an
# Origin allowlist, or startup fails.
N8N_OPERATOR_HTTP_BIND=127.0.0.1:8000

# Required only for a non-loopback HTTP bind. Generate a high-entropy value;
# do not reuse a token from anywhere else.
# N8N_OPERATOR_HTTP_BEARER_TOKEN=replace-me-with-a-generated-token

# Required only for a non-loopback HTTP bind. Comma-separated allowlist.
# N8N_OPERATOR_HTTP_ALLOWED_ORIGINS=https://client.example.invalid

# --- Limits and logging -----------------------------------------------------
# Ceiling on request duration; a per-workflow `limits` block may lower it.
N8N_OPERATOR_REQUEST_TIMEOUT_SECONDS=60

# DEBUG | INFO | WARNING | ERROR. Structured JSON logs with secret scrubbing.
N8N_OPERATOR_LOG_LEVEL=INFO
